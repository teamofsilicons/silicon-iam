{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Dedicated public ALB and WAF for Silicon iam; no Glass resource references.",
  "Parameters": {
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id"
    },
    "PublicSubnetA": {
      "Type": "AWS::EC2::Subnet::Id"
    },
    "PublicSubnetB": {
      "Type": "AWS::EC2::Subnet::Id"
    },
    "InstanceSecurityGroupId": {
      "Type": "AWS::EC2::SecurityGroup::Id"
    },
    "CertificateArn": {
      "Type": "String"
    }
  },
  "Resources": {
    "LoadBalancerSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "silicon-iam-edge: public HTTPS and HTTP redirect",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          }
        ],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 8080,
            "ToPort": 8080,
            "DestinationSecurityGroupId": {
              "Ref": "InstanceSecurityGroupId"
            }
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": "silicon-iam-edge"
          }
        ]
      }
    },
    "ApiIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "InstanceSecurityGroupId"
        },
        "IpProtocol": "tcp",
        "FromPort": 8080,
        "ToPort": 8080,
        "SourceSecurityGroupId": {
          "Ref": "LoadBalancerSecurityGroup"
        },
        "Description": "Dedicated iam ALB to API"
      }
    },
    "LoadBalancer": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Name": "silicon-iam-edge",
        "Scheme": "internet-facing",
        "Type": "application",
        "IpAddressType": "ipv4",
        "Subnets": [
          {
            "Ref": "PublicSubnetA"
          },
          {
            "Ref": "PublicSubnetB"
          }
        ],
        "SecurityGroups": [
          {
            "Ref": "LoadBalancerSecurityGroup"
          }
        ],
        "LoadBalancerAttributes": [
          {
            "Key": "deletion_protection.enabled",
            "Value": "true"
          },
          {
            "Key": "idle_timeout.timeout_seconds",
            "Value": "1200"
          },
          {
            "Key": "routing.http.drop_invalid_header_fields.enabled",
            "Value": "true"
          },
          {
            "Key": "routing.http.desync_mitigation_mode",
            "Value": "defensive"
          }
        ]
      }
    },
    "ApiTargetGroup": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "Name": "silicon-iam-edge-api",
        "VpcId": {
          "Ref": "VpcId"
        },
        "Protocol": "HTTP",
        "Port": 8080,
        "TargetType": "instance",
        "HealthCheckEnabled": true,
        "HealthCheckPath": "/readyz",
        "HealthCheckProtocol": "HTTP",
        "HealthCheckIntervalSeconds": 15,
        "HealthCheckTimeoutSeconds": 5,
        "HealthyThresholdCount": 2,
        "UnhealthyThresholdCount": 3,
        "Matcher": {
          "HttpCode": "200"
        },
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "30"
          }
        ]
      }
    },
    "HttpsListener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "LoadBalancer"
        },
        "Port": 443,
        "Protocol": "HTTPS",
        "SslPolicy": "ELBSecurityPolicy-TLS13-1-2-2021-06",
        "Certificates": [
          {
            "CertificateArn": {
              "Ref": "CertificateArn"
            }
          }
        ],
        "DefaultActions": [
          {
            "Type": "fixed-response",
            "FixedResponseConfig": {
              "StatusCode": "404",
              "ContentType": "text/plain",
              "MessageBody": "Not found"
            }
          }
        ]
      }
    },
    "ApiListenerRule": {
      "Type": "AWS::ElasticLoadBalancingV2::ListenerRule",
      "Properties": {
        "ListenerArn": {
          "Ref": "HttpsListener"
        },
        "Priority": 10,
        "Conditions": [
          {
            "Field": "host-header",
            "HostHeaderConfig": {
              "Values": [
                "backend.iam.teamofsilicons.com"
              ]
            }
          }
        ],
        "Actions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "ApiTargetGroup"
            }
          }
        ]
      }
    },
    "HttpListener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "LoadBalancer"
        },
        "Port": 80,
        "Protocol": "HTTP",
        "DefaultActions": [
          {
            "Type": "redirect",
            "RedirectConfig": {
              "Protocol": "HTTPS",
              "Port": "443",
              "Host": "backend.iam.teamofsilicons.com",
              "Path": "/#{path}",
              "Query": "#{query}",
              "StatusCode": "HTTP_301"
            }
          }
        ]
      }
    },
    "WebAcl": {
      "Type": "AWS::WAFv2::WebACL",
      "Properties": {
        "Name": "silicon-iam-edge",
        "Scope": "REGIONAL",
        "DefaultAction": {
          "Allow": {}
        },
        "VisibilityConfig": {
          "SampledRequestsEnabled": false,
          "CloudWatchMetricsEnabled": true,
          "MetricName": "silicon-iam-edge"
        },
        "Rules": [
          {
            "Name": "rate-limit",
            "Priority": 0,
            "Statement": {
              "RateBasedStatement": {
                "Limit": 100000,
                "EvaluationWindowSec": 300,
                "AggregateKeyType": "IP"
              }
            },
            "Action": {
              "Block": {}
            },
            "VisibilityConfig": {
              "SampledRequestsEnabled": false,
              "CloudWatchMetricsEnabled": true,
              "MetricName": "rate-limit"
            }
          },
          {
            "Name": "common",
            "Priority": 1,
            "Statement": {
              "ManagedRuleGroupStatement": {
                "VendorName": "AWS",
                "Name": "AWSManagedRulesCommonRuleSet",
                "RuleActionOverrides": [
                  {
                    "Name": "SizeRestrictions_Cookie_HEADER",
                    "ActionToUse": {
                      "Count": {}
                    }
                  },
                  {
                    "Name": "EC2MetaDataSSRF_COOKIE",
                    "ActionToUse": {
                      "Count": {}
                    }
                  },
                  {
                    "Name": "CrossSiteScripting_COOKIE",
                    "ActionToUse": {
                      "Count": {}
                    }
                  },
                  {
                    "Name": "EC2MetaDataSSRF_QUERYARGUMENTS",
                    "ActionToUse": {
                      "Count": {}
                    }
                  }
                ]
              }
            },
            "OverrideAction": {
              "None": {}
            },
            "VisibilityConfig": {
              "SampledRequestsEnabled": false,
              "CloudWatchMetricsEnabled": true,
              "MetricName": "common"
            }
          },
          {
            "Name": "cookie-block-except-registration",
            "Priority": 2,
            "Action": {
              "Block": {}
            },
            "Statement": {
              "AndStatement": {
                "Statements": [
                  {
                    "OrStatement": {
                      "Statements": [
                        {
                          "LabelMatchStatement": {
                            "Scope": "LABEL",
                            "Key": "awswaf:managed:aws:core-rule-set:SizeRestrictions_Cookie_Header"
                          }
                        },
                        {
                          "LabelMatchStatement": {
                            "Scope": "LABEL",
                            "Key": "awswaf:managed:aws:core-rule-set:EC2MetaDataSSRF_Cookie"
                          }
                        },
                        {
                          "LabelMatchStatement": {
                            "Scope": "LABEL",
                            "Key": "awswaf:managed:aws:core-rule-set:CrossSiteScripting_Cookie"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "NotStatement": {
                      "Statement": {
                        "RegexMatchStatement": {
                          "RegexString": "^/api/v1/auth/register(?:/|$)",
                          "FieldToMatch": {
                            "UriPath": {}
                          },
                          "TextTransformations": [
                            {
                              "Priority": 0,
                              "Type": "NONE"
                            }
                          ]
                        }
                      }
                    }
                  }
                ]
              }
            },
            "VisibilityConfig": {
              "SampledRequestsEnabled": false,
              "CloudWatchMetricsEnabled": true,
              "MetricName": "cookie-block-except-registration"
            }
          },
          {
            "Name": "ssrf-query-except-briefcase-local-callback",
            "Priority": 3,
            "Action": {
              "Block": {}
            },
            "Statement": {
              "AndStatement": {
                "Statements": [
                  {
                    "LabelMatchStatement": {
                      "Scope": "LABEL",
                      "Key": "awswaf:managed:aws:core-rule-set:EC2MetaDataSSRF_QueryArguments"
                    }
                  },
                  {
                    "NotStatement": {
                      "Statement": {
                        "AndStatement": {
                          "Statements": [
                            {
                              "ByteMatchStatement": {
                                "SearchString": "backend.iam.teamofsilicons.com",
                                "FieldToMatch": {
                                  "SingleHeader": {
                                    "Name": "host"
                                  }
                                },
                                "TextTransformations": [
                                  {
                                    "Priority": 0,
                                    "Type": "LOWERCASE"
                                  }
                                ],
                                "PositionalConstraint": "EXACTLY"
                              }
                            },
                            {
                              "ByteMatchStatement": {
                                "SearchString": "GET",
                                "FieldToMatch": {
                                  "Method": {}
                                },
                                "TextTransformations": [
                                  {
                                    "Priority": 0,
                                    "Type": "NONE"
                                  }
                                ],
                                "PositionalConstraint": "EXACTLY"
                              }
                            },
                            {
                              "ByteMatchStatement": {
                                "SearchString": "/api/v1/login",
                                "FieldToMatch": {
                                  "UriPath": {}
                                },
                                "TextTransformations": [
                                  {
                                    "Priority": 0,
                                    "Type": "NONE"
                                  }
                                ],
                                "PositionalConstraint": "EXACTLY"
                              }
                            },
                            {
                              "ByteMatchStatement": {
                                "SearchString": "tos>briefcase",
                                "FieldToMatch": {
                                  "SingleQueryArgument": {
                                    "Name": "app_id"
                                  }
                                },
                                "TextTransformations": [
                                  {
                                    "Priority": 0,
                                    "Type": "URL_DECODE"
                                  }
                                ],
                                "PositionalConstraint": "EXACTLY"
                              }
                            },
                            {
                              "RegexMatchStatement": {
                                "RegexString": "^http://localhost:4317/auth/callback[?]state=[0-9a-f]{64}$",
                                "FieldToMatch": {
                                  "SingleQueryArgument": {
                                    "Name": "redirect_uri"
                                  }
                                },
                                "TextTransformations": [
                                  {
                                    "Priority": 0,
                                    "Type": "URL_DECODE"
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      }
                    }
                  }
                ]
              }
            },
            "VisibilityConfig": {
              "SampledRequestsEnabled": false,
              "CloudWatchMetricsEnabled": true,
              "MetricName": "ssrf-query-except-briefcase-local-callback"
            }
          },
          {
            "Name": "known-bad-inputs",
            "Priority": 4,
            "Statement": {
              "ManagedRuleGroupStatement": {
                "VendorName": "AWS",
                "Name": "AWSManagedRulesKnownBadInputsRuleSet"
              }
            },
            "OverrideAction": {
              "None": {}
            },
            "VisibilityConfig": {
              "SampledRequestsEnabled": false,
              "CloudWatchMetricsEnabled": true,
              "MetricName": "known-bad-inputs"
            }
          }
        ]
      }
    },
    "WebAclAssociation": {
      "Type": "AWS::WAFv2::WebACLAssociation",
      "Properties": {
        "ResourceArn": {
          "Ref": "LoadBalancer"
        },
        "WebACLArn": {
          "Fn::GetAtt": [
            "WebAcl",
            "Arn"
          ]
        }
      }
    },
    "WafLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "LogGroupName": "aws-waf-logs-silicon-iam-edge",
        "RetentionInDays": 30
      }
    },
    "WafLogging": {
      "Type": "AWS::WAFv2::LoggingConfiguration",
      "Properties": {
        "ResourceArn": {
          "Fn::GetAtt": [
            "WebAcl",
            "Arn"
          ]
        },
        "LogDestinationConfigs": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:aws-waf-logs-silicon-iam-edge"
          }
        ],
        "RedactedFields": [
          { "SingleHeader": { "Name": "x-iam-obo-access-proof" } },
          { "SingleHeader": { "Name": "x-step-up-token" } },
          { "SingleHeader": { "Name": "x-csrf-token" } },
          { "SingleHeader": { "Name": "x-silicon-iam-signature" } },
          {
            "QueryString": {}
          },
          {
            "UriPath": {}
          },
          {
            "SingleHeader": {
              "Name": "authorization"
            }
          },
          {
            "SingleHeader": {
              "Name": "cookie"
            }
          },
          {
            "SingleHeader": {
              "Name": "origin"
            }
          },
          {
            "SingleHeader": {
              "Name": "referer"
            }
          },
          {
            "SingleHeader": {
              "Name": "user-agent"
            }
          },
          {
            "SingleHeader": {
              "Name": "x-forwarded-for"
            }
          },
          {
            "SingleHeader": {
              "Name": "x-testing-environment-key"
            }
          },
          {
            "SingleHeader": {
              "Name": "x-iam-testing-environment-key"
            }
          },
          {
            "SingleHeader": {
              "Name": "x-silicon-key"
            }
          },
          {
            "SingleHeader": {
              "Name": "x-team-key"
            }
          }
        ],
        "LoggingFilter": {
          "DefaultBehavior": "DROP",
          "Filters": [
            {
              "Behavior": "KEEP",
              "Requirement": "MEETS_ANY",
              "Conditions": [
                {
                  "ActionCondition": {
                    "Action": "BLOCK"
                  }
                }
              ]
            }
          ]
        }
      },
      "DependsOn": "WafLogGroup"
    }
  },
  "Outputs": {
    "LoadBalancerArn": {
      "Value": {
        "Ref": "LoadBalancer"
      }
    },
    "LoadBalancerDnsName": {
      "Value": {
        "Fn::GetAtt": [
          "LoadBalancer",
          "DNSName"
        ]
      }
    },
    "HttpsListenerArn": {
      "Value": {
        "Ref": "HttpsListener"
      }
    },
    "AlbSecurityGroupId": {
      "Value": {
        "Ref": "LoadBalancerSecurityGroup"
      }
    },
    "ApiTargetGroupArn": {
      "Value": {
        "Ref": "ApiTargetGroup"
      }
    },
    "PublicHostName": {
      "Value": "backend.iam.teamofsilicons.com"
    },
    "WebAclArn": {
      "Value": {
        "Fn::GetAtt": [
          "WebAcl",
          "Arn"
        ]
      }
    }
  }
}
