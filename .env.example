# Process and HTTP policy
IAM_ENVIRONMENT=development
IAM_BIND_ADDR=127.0.0.1:8080
IAM_PUBLIC_BASE_URL=http://localhost:8080
IAM_AUTH_BASE_URL=http://localhost:3000
IAM_CORS_ALLOWED_ORIGINS=http://localhost:3000
IAM_REQUEST_TIMEOUT_SECONDS=15
IAM_MAX_BODY_BYTES=65536
IAM_MAX_CONCURRENT_REQUESTS=512
IAM_SHUTDOWN_TIMEOUT_SECONDS=30
IAM_LOG_FILTER=silicon_iam=debug,tower_http=info

# Restricted API PostgreSQL principal. A worker process should receive its own
# IAM_DATABASE_URL using the worker role. Production must use sslmode=verify-full.
IAM_DATABASE_URL=postgres://silicon_iam_api_runtime:<local-api-db-password>@127.0.0.1:5432/silicon_iam
IAM_DATABASE_MAX_CONNECTIONS=16
IAM_DATABASE_MIN_CONNECTIONS=1
IAM_DATABASE_ACQUIRE_TIMEOUT_SECONDS=3
IAM_DATABASE_STATEMENT_TIMEOUT_SECONDS=10

# Privileged one-shot migration principal. Use a distinct credential in
# production; sharing the local development principal is acceptable locally.
IAM_MIGRATOR_DATABASE_URL=postgres://silicon_iam_migrator:<local-migrator-db-password>@127.0.0.1:5432/silicon_iam
IAM_MIGRATOR_DATABASE_MAX_CONNECTIONS=2
IAM_MIGRATOR_DATABASE_ACQUIRE_TIMEOUT_SECONDS=10
IAM_MIGRATOR_DATABASE_STATEMENT_TIMEOUT_SECONDS=120

# Narrow one-shot runtime-key activation principal. It has no table authority
# and can execute only the compare-and-swap key activation function.
IAM_KEY_OPERATOR_DATABASE_URL=postgres://silicon_iam_key_operator_runtime:<local-key-operator-db-password>@127.0.0.1:5432/silicon_iam

# Local Compose database credentials. The bootstrap script generates URL-safe
# random values. Production credentials belong in the deployment secret store.
IAM_LOCAL_MIGRATOR_DATABASE_PASSWORD=<local-migrator-db-password>
IAM_LOCAL_API_DATABASE_PASSWORD=<local-api-db-password>
IAM_LOCAL_WORKER_DATABASE_PASSWORD=<local-worker-db-password>
IAM_LOCAL_KEY_OPERATOR_DATABASE_PASSWORD=<local-key-operator-db-password>

# Generate independent 32-byte values and encode them as canonical base64url
# without padding. Keyrings are JSON objects keyed by positive small-integer
# versions. Retain historical keys while stored values still reference them.
# Never reuse key material between keyrings or cookies. Compose
# injects only the encryption keyring into iam-worker; token pepper, blind-index,
# and cookie authority remain API-only.
IAM_TOKEN_PEPPER_CURRENT_VERSION=1
IAM_TOKEN_PEPPER_KEYRING='{"1":"<base64url-32-byte-token-pepper>"}'
IAM_BLIND_INDEX_CURRENT_VERSION=1
IAM_BLIND_INDEX_KEYRING='{"1":"<base64url-32-byte-blind-index-key>"}'
IAM_ENCRYPTION_CURRENT_VERSION=1
IAM_ENCRYPTION_KEYRING='{"1":"<base64url-32-byte-encryption-key>"}'
IAM_COOKIE_KEY=<base64url-32-byte-cookie-key>

# Exact credential and challenge contract values. Startup rejects an override
# that differs; these are deployment assertions rather than tuning knobs.
IAM_ACCESS_TOKEN_TTL_SECONDS=1800
IAM_REFRESH_FAMILY_TTL_SECONDS=77760000
IAM_AUTHORIZATION_CODE_TTL_SECONDS=120
IAM_OTP_TTL_SECONDS=600
IAM_OTP_MAX_ATTEMPTS=10

# External providers. IAM generates and verifies OTPs; Twilio's Messages API
# only delivers them. Twilio and WorkOS groups must each be either complete or
# absent outside production. Production requires every credential below. The
# worker receives Postmark, Twilio, and Iris settings only; WorkOS authority
# remains API-only.
IAM_POSTMARK_SERVER_TOKEN=
IAM_POSTMARK_FROM_EMAIL=auth@teamofsilicons.com
IAM_TWILIO_ACCOUNT_SID=
IAM_TWILIO_AUTH_TOKEN=
IAM_TWILIO_MESSAGING_SERVICE_SID=
IAM_TWILIO_VERIFY_SERVICE_SID=
IAM_WORKOS_API_KEY=
IAM_WORKOS_CLIENT_ID=
IAM_WORKOS_WEBHOOK_SECRET=
IAM_IRIS_BASE_URL=https://iris.teamofsilicons.com

# Development/test only. Production rejects both settings. The worker receives
# IAM_ALLOW_LOCAL_PROVIDERS but never IAM_EXPOSE_LOCAL_OTPS.
IAM_ALLOW_LOCAL_PROVIDERS=true
IAM_EXPOSE_LOCAL_OTPS=true

# Durable worker policy
IAM_WORKER_BATCH_SIZE=100
IAM_WORKER_DELIVERY_CONCURRENCY=16
IAM_WORKER_POLL_INTERVAL_MS=500
IAM_WORKER_LEASE_SECONDS=60
IAM_WORKER_MAX_ATTEMPTS=20
IAM_WORKER_MAX_RETRY_DELAY_SECONDS=300

# Bounded worker retention policy (one round-robin phase per interval)
IAM_RETENTION_SWEEP_INTERVAL_SECONDS=30
# Root records per phase; accepted range is 1..1000.
IAM_RETENTION_BATCH_SIZE=1000
IAM_RETENTION_LOGIN_HISTORY_DAYS=365
IAM_RETENTION_EPHEMERAL_SECURITY_DAYS=30
IAM_RETENTION_TOKEN_METADATA_DAYS=90
IAM_RETENTION_COMPROMISED_REFRESH_DAYS=365
IAM_RETENTION_WEBHOOK_ATTEMPT_DAYS=45
IAM_RETENTION_AUDIT_EVENT_DAYS=2555
