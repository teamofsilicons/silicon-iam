# Server-side values. Never prefix these with VITE_.
API_UPSTREAM=https://backend.iam.teamofsilicons.com
CONSOLE_ORIGIN=https://iam.teamofsilicons.com
AUTH_ORIGIN=https://auth.iam.teamofsilicons.com
# Generate a fresh value: openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'
SESSION_COOKIE_KEY=
# Shared only among trusted IAM hosts; do not use teamofsilicons.com.
COOKIE_DOMAIN=iam.teamofsilicons.com
DISPLAY_ENVIRONMENT=Production
HOST=127.0.0.1
PORT=4310

# Optional Space Station telemetry. Defaults on only when a private key is configured.
# Keep keys server-side; never prefix them with VITE_. See docs/TELEMETRY.md.
IAM_TELEMETRY=on
# IAM_TELEMETRY_KEY_FILE=/run/secrets/iam-telemetry.key
# IAM_TELEMETRY_KEY=<private-siliconiam-table-key>
# Native processes need a writable private spool, ideally on a persistent volume.
# IAM_TELEMETRY_HOME=/var/lib/silicon-iam/telemetry-spool
